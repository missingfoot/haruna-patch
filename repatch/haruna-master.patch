+                return Qt.SizeFDiagCursor
+            }
+            if (resizeEdges === (Qt.RightEdge | Qt.TopEdge) || resizeEdges === (Qt.LeftEdge | Qt.BottomEdge)) {
+                return Qt.SizeBDiagCursor
+            }
+            if (resizeEdges & (Qt.LeftEdge | Qt.RightEdge)) {
+                return Qt.SizeHorCursor
