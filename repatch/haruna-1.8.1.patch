+        // like mpc-qt: left button actions are triggered on release, dragging with the left button
+        // moves the window and pressing near the window edges resizes it
+        property point leftPressPosition
+        property bool windowMoving: false
+        property int resizeEdges: 0
+        readonly property int resizeMargin: 10
+
+        function canMoveWindow() : bool {
+            return !root.window.isFullScreen() && !root.window.isMaximized()
+        }
+
+        function edgesAt(x: real, y: real) : int {
+            if (!canMoveWindow()) {
+                return 0
+            }
+            const point = mapToItem(null, x, y)
+            let edges = 0
+            if (point.x < resizeMargin) {
+                edges |= Qt.LeftEdge
+            }
+            if (point.x > root.window.width - resizeMargin) {
+                edges |= Qt.RightEdge
+            }
+            if (point.y < resizeMargin) {
+                edges |= Qt.TopEdge
+            }
+            if (point.y > root.window.height - resizeMargin) {
+                edges |= Qt.BottomEdge
+            }
+            return edges
+        }
+
+        function panVideo(dx: real, dy: real) : void {
+            const zoom = root.getProperty(MpvProperties.VideoZoom)
+            const aspect = root.getProperty(MpvProperties.AspectRatio)
+            if (!(zoom > 0) || !(aspect > 0)) {
+                return
+            }
+            // video-pan-x/y are fractions of the scaled video size,
+            // so divide by the displayed size to make the video follow the cursor
+            const scale = Math.pow(2, zoom)
+            const fitWidth = Math.min(width, height * aspect)
+            const fitHeight = fitWidth / aspect
+            const panX = root.getProperty(MpvProperties.VideoPanX) + dx / (fitWidth * scale)
+            const panY = root.getProperty(MpvProperties.VideoPanY) + dy / (fitHeight * scale)
+            root.setProperty(MpvProperties.VideoPanX, panX)
+            root.setProperty(MpvProperties.VideoPanY, panY)
+            panning = true
+        }
 
